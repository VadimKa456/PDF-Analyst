# =====================================================================
# PDF Analyst — пример конфигурации.
# Скопируйте файл в .env и измените значения при необходимости.
# Все параметры также можно задать в разделе «Настройки» интерфейса —
# значения из интерфейса имеют приоритет над .env.
# =====================================================================

# --- Сервер ---
HOST=127.0.0.1
PORT=8000
# Каталог для базы данных, загруженных PDF и экспортов.
# Относительный путь считается от корня проекта, а не от текущего каталога.
DATA_DIR=./data
# Максимальный размер одного PDF, МБ
MAX_UPLOAD_MB=100
# Разрешённые источники для CORS (через запятую). For dev Vite: http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# --- OCR ---
# Путь к tesseract.exe. Если не задан, приложение ищет его автоматически.
# Windows (per-user установка): %LOCALAPPDATA%\Programs\Tesseract-OCR\tesseract.exe
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_ENABLED=true
OCR_LANGUAGES=rus+eng
OCR_DPI=300
OCR_MIN_CONFIDENCE=65
# Автоматически запускать OCR, если на странице мало текста
OCR_AUTO=true

# --- AI (OpenAI или совместимый API) ---
# Оставьте пустым, чтобы работать без внешней модели:
# встроенный локальный аналитический движок выполнит запрос детерминированно.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# Включить локальные эмбеддинги для семантического поиска (Ollama)
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Поведение AI ---
# openai | ollama | none  (none = только локальный движок)
AI_PROVIDER=none
AI_TEMPERATURE=0.1
AI_TIMEOUT_SECONDS=90
# Семантический поиск через embeddings (может быть медленнее)
SEMANTIC_SEARCH=false

# --- Экспорт ---
REPORT_PAGE_SIZE=A4
REPORT_INCLUDE_SOURCES=true
